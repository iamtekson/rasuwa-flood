{
  "map": {
    "title": "Bhotekoshi River Flood - August 2026",
    "center": [85.05, 28.05],
    "zoom": 10,
    "bounds": [[84.3, 27.72], [85.72, 28.36]],
    "pitch": 60,
    "bearing": 57,
    "terrain3d": {
      "pitch": 60,
      "bearing": 57
    },
    "icons": {
      "bridge": "map_icons/bridge.svg",
      "education": "map_icons/education.svg",
      "health": "map_icons/health.svg",
      "video_play": "map_icons/video-play.svg",
      "hazard_pin": "map_icons/hazard-pin.svg",
      "glacier_pin": "map_icons/glacier-pin.svg",
      "hydropower": { "url": "map_icons/hydropower.svg", "sdf": true }
    },
    "basemap": {
      "id": "esri_imagery",
      "label": "Esri World Imagery",
      "tiles": ["https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"],
      "tileSize": 256,
      "attribution": "Esri, Maxar, Earthstar Geographics"
    },
    "terrain": {
      "tiles": ["https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"],
      "encoding": "terrarium",
      "tileSize": 256,
      "maxzoom": 15,
      "exaggeration": 1.3,
      "attribution": "AWS Terrain Tiles"
    }
  },
  "categories": [
    {
      "id": "imagery",
      "label": "Imagery (Pre / Post)",
      "layers": [
        {
          "id": "post_imagery",
          "label": "Post-Disaster Imagery (Vantor, 28 Aug 2026)",
          "type": "raster",
          "tiles": ["https://titiler.hotosm.org/cog/tiles/WebMercatorQuad/{z}/{x}/{y}@1x?url=https%3A%2F%2Fproduction-raw-data-api.s3.amazonaws.com%2FISO3%2FNPL%2Fdisasters%2Fnepal-flood%2F2026-08-28%2Fvantor_composite_v3.tif"],
          "tileSize": 256,
          "attribution": "Vantor / HOTOSM raw-data-api",
          "active": true
        },
        {
          "id": "pre_imagery",
          "label": "Pre-Disaster Reference (Sentinel-2 cloud-free mosaic)",
          "type": "raster",
          "tiles": ["https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg"],
          "tileSize": 256,
          "attribution": "Sentinel-2 cloudless by EOX IT Services GmbH",
          "note": "General cloud-free baseline mosaic, not a same-date pre-event snapshot.",
          "active": false
        }
      ]
    },
    {
      "id": "flood",
      "label": "Flood Extent & River",
      "layers": [
        {
          "id": "flood_extent",
          "label": "Flood Extent (observed 27 Aug 2026)",
          "type": "fill",
          "data": "https://production-raw-data-api.s3.amazonaws.com/ISO3/NPL/combined/hot_flood_npl_aoi.geojson",
          "paint": { "fillColor": "#1f9dd6", "fillOpacity": 0.35, "lineColor": "#0b5b7a", "lineWidth": 1.5 },
          "active": true
        },
        {
          "id": "river_buffer",
          "label": "Bhotekoshi River 2km Buffer",
          "type": "line",
          "data": "data/bhotekoshi_river_2km_buffer.geojson",
          "paint": { "lineColor": "#e8871e", "lineWidth": 1.5, "lineDasharray": [3, 2] },
          "active": true
        },
        {
          "id": "river",
          "label": "Bhotekoshi River",
          "type": "line",
          "data": "data/bhotekoshi_river.geojson",
          "paint": { "lineColor": "#0f5fa6", "lineWidth": 2 },
          "active": true
        }
      ]
    },
    {
      "id": "boundaries",
      "label": "Administrative Boundaries",
      "layers": [
        {
          "id": "gn_affected",
          "label": "Affected Municipalities (Gaunpalika / Nagarpalika)",
          "type": "fill",
          "data": "data/gn_affected.json",
          "paint": { "fillColor": "#ffffff", "fillOpacity": 0.03, "lineColor": "#ffffff", "lineWidth": 0.2 },
          "labelField": "GaPa_NaPa",
          "popupFields": ["GaPa_NaPa", "Type_GN", "DISTRICT", "Province"],
          "popupLabels": { "GaPa_NaPa": "Municipality", "Type_GN": "Type", "DISTRICT": "District", "Province": "Province" },
          "popupTrigger": "click",
          "statsField": "Type_GN",
          "spotlight": { "color": "#000000", "opacity": 0.55 },
          "active": true
        }
      ]
    },
    {
      "id": "essential",
      "label": "Essential Facilities",
      "layers": [
        {
          "id": "buildings",
          "label": "Buildings near flood zone (Overture)",
          "type": "fill",
          "data": "data/buildings_essential.geojson",
          "paint": { "fillColor": "#c9b458", "fillOpacity": 0.55, "lineColor": "#7a6a2a", "lineWidth": 0.5 },
          "active": false,
          "minzoom": 13
        },
        {
          "id": "bridges",
          "label": "Bridges (OSM)",
          "type": "icon",
          "icon": "bridge",
          "iconSize": 0.45,
          "data": "data/bridges.geojson",
          "popupFields": ["name", "bridge_structure", "highway"],
          "statsField": "highway",
          "active": false
        },
        {
          "id": "education",
          "label": "Educational Institutes (Overture)",
          "type": "icon",
          "icon": "education",
          "iconSize": 0.45,
          "data": "data/education_facilities.geojson",
          "labelField": "name",
          "statsField": "category",
          "active": false
        },
        {
          "id": "health",
          "label": "Health Facilities (Overture)",
          "type": "icon",
          "icon": "health",
          "iconSize": 0.45,
          "data": "data/health_facilities.geojson",
          "labelField": "name",
          "statsField": "category",
          "active": false
        }
      ]
    },
    {
      "id": "damage",
      "label": "Damage Assessment",
      "layers": [
        {
          "id": "bridge_damage",
          "label": "Bridge Damage Assessment",
          "type": "circle",
          "data": "https://production-raw-data-api.s3.amazonaws.com/ISO3/NPL/combined/hot_flood_npl_bridge_damage.geojson",
          "paint": {
            "circleColor": {
              "field": "status",
              "values": { "Washed out": "#d62728", "Damaged": "#ff9f1c", "Intact": "#2ca02c" },
              "default": "#888888"
            },
            "circleRadius": 7,
            "circleStrokeColor": "#ffffff",
            "circleStrokeWidth": 1.5
          },
          "labelField": "name",
          "popupFields": ["name", "status", "location"],
          "note": "Colored by status: red = washed out, orange = damaged, green = intact.",
          "active": false
        },
        {
          "id": "destroyed_buildings",
          "label": "Destroyed Buildings (OSM)",
          "type": "fill",
          "data": "data/destroyed_buildings.geojson",
          "paint": { "fillColor": "#d62728", "fillOpacity": 0.6, "lineColor": "#7a1414", "lineWidth": 0.5 },
          "active": false
        },
        {
          "id": "exposed_hydropowers",
          "label": "Exposed Hydropowers (Niti Foundation)",
          "type": "icon",
          "icon": "hydropower",
          "iconSize": 0.5,
          "iconColor": {
            "field": "Status",
            "values": { "Operation": "#d62728", "Under Construction": "#ff9f1c", "Survey": "#4a90d9" },
            "default": "#888888"
          },
          "data": "data/exposed_hydropowers.geojson",
          "labelField": "Project",
          "popupFields": ["Project", "Status", "Capacity (MW)", "River", "Promoter", "Address"],
          "popupLabels": { "Capacity (MW)": "Capacity (MW)" },
          "note": "Colored by status: red = operating, orange = under construction, blue = surveyed (not yet built).",
          "active": false
        }
      ]
    },
    {
      "id": "other",
      "label": "Other",
      "layers": [
        {
          "id": "key_locations",
          "label": "Key Locations (flood origin, glacier)",
          "type": "icon",
          "iconField": "icon",
          "iconSize": 0.6,
          "data": "data/key_locations_v2.geojson",
          "labelField": "name",
          "alwaysLabel": true,
          "autoPopupOnHighlight": true,
          "polygonPaint": {
            "fillColor": {
              "field": "kind",
              "values": { "hazard": "#ffd400", "lake": "#1e88e5" },
              "default": "#ff5a36"
            },
            "fillOpacity": 0.6,
            "lineColor": {
              "field": "kind",
              "values": { "hazard": "#a87b00", "lake": "#0d47a1" },
              "default": "#a8331d"
            },
            "lineWidth": 2.5
          },
          "active": true
        },
        {
          "id": "cities",
          "label": "Major Settlements",
          "type": "circle",
          "data": "data/cities.geojson",
          "paint": { "circleColor": "#ffffff", "circleRadius": 5, "circleStrokeColor": "#333333", "circleStrokeWidth": 1.5 },
          "labelField": "name",
          "statsField": "region",
          "autoPopupOnHighlight": true,
          "active": true
        }
       
      ]
    }
  ]
}
